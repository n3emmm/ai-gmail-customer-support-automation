    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst original = $('Prepare Email Data').item.json;\n\nconst text = $json.content?.parts?.[0]?.text;\n\nif (!text) {\n  throw new Error(\"Gemini response text is missing\");\n}\n\nlet aiResult;\n\ntry {\n  aiResult = JSON.parse(text);\n} catch {\n  throw new Error(\"Gemini did not return valid JSON\");\n}\n\nconst requiredFields = [\n  \"category\",\n  \"summary\",\n  \"language\",\n  \"priority\",\n  \"confidence\",\n  \"needs_human_review\",\n  \"reason_for_review\"\n];\n\nfor (const field of requiredFields) {\n  if (aiResult[field] === undefined) {\n    throw new Error(`Missing AI field: ${field}`);\n  }\n}\n\nreturn {\n  json: {\n    ...original,\n    aiResult\n  }\n};\n"
      },
