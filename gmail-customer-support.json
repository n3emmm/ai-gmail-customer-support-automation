      ],
      "id": "20421e16-1891-4e2e-b127-d1c7f8de6ca3",
      "name": "Generate Customer Reply"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst to = String($json.From || \"\").match(/<([^>]+)>/)?.[1];\n\nif (!to) {\n  throw new Error(\"Customer email address not found\");\n}\n\nconst subject = String($json.Subject || \"\");\nconst reply = String($json.reply || \"\");\n\nif (!reply) {\n  throw new Error(\"Reply is empty\");\n}\n\nconst draftMessage = [\n  `To: ${to}`,\n  `Subject: Re: ${subject}`,\n  \"Content-Type: text/plain; charset=UTF-8\",\n  \"MIME-Version: 1.0\",\n  \"\",\n  reply\n].join(\"\\r\\n\");\n\nconst raw = Buffer.from(draftMessage)\n  .toString(\"base64url\");\n\nreturn {\n  json: {\n    ...$json,\n    raw\n  }\n};\n"
      },
