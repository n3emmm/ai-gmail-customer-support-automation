    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst original = $('Exclude Spam & Marketing').all()[$itemIndex].json;\n\nconst reply = $json.content?.parts?.[0]?.text?.trim();\n\nif (!reply) {\n  throw new Error(\"AI reply is empty\");\n}\n\nreturn {\n  json: {\n    ...original,\n    reply\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
