        "messages": {
          "values": [
            {
              "content": "=\nWrite a professional customer support email reply.\n\nUse the customer's original language.\n\nCustomer details:\nSender: {{ $json.From }}\nSubject: {{ $json.Subject }}\nMessage: {{ $json.emailBody }}\n\nClassification:\nCategory: {{ $json.aiResult.category }}\nSummary: {{ $json.aiResult.summary }}\nPriority: {{ $json.aiResult.priority }}\n\nRules:\n- Reply directly to the customer's issue.\n- Be polite, clear, and concise.\n- Ask for missing information when necessary.\n- Never invent order details, company policies, refunds, or actions.\n- Do not claim that an issue has been fixed unless confirmed.\n- Do not include a subject line.\n- Return only the email body.\n"
            }
          ]
