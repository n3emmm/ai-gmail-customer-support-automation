    {
      "parameters": {
        "jsCode": "const blocked = [\n  \"newsletter.example.com\",\n  \"notifications.example.com\",\n  \"social.example.com\"\n];\n\nreturn $input.all().filter(item => {\n  const sender = (item.json.From || \"\").toLowerCase();\n  const labels = item.json.labels || [];\n\n  const isBlocked = blocked.some(domain =>\n    sender.includes(domain)\n  );\n\n  const isPromotion = labels.some(label =>\n    label.id === \"CATEGORY_PROMOTIONS\"\n  );\n\n  return !isBlocked && !isPromotion;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
